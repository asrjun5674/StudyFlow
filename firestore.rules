rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function linkId(studentUid, parentUid) {
      return studentUid + "_" + parentUid;
    }

    // Basic user profile.
    match /users/{uid} {
      allow create: if isUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['student', 'parent'];

      allow read: if isUser(uid);

      allow update: if isUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // One cloud-saved plan per student.
    match /plans/{studentUid} {
      allow read, create, update: if isUser(studentUid);

      // Parents can read a student's plan only when the link exists.
      allow get: if signedIn()
        && get(/databases/$(database)/documents/links/$(linkId(studentUid, request.auth.uid))).data.studentUid == studentUid
        && get(/databases/$(database)/documents/links/$(linkId(studentUid, request.auth.uid))).data.parentUid == request.auth.uid;

      allow delete: if isUser(studentUid);
    }

    // Temporary student-created pairing codes.
    match /pairingCodes/{code} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.expiresAt > request.time;

      // A signed-in parent can read a code in order to claim it.
      allow get: if signedIn();

      // Student can renew/delete own codes.
      allow update, delete: if signedIn()
        && resource.data.studentUid == request.auth.uid;
    }

    // Parent-child link.
    match /links/{linkId} {
      allow create: if signedIn()
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.studentUid is string;

      allow read: if signedIn()
        && (resource.data.parentUid == request.auth.uid
            || resource.data.studentUid == request.auth.uid);

      allow delete: if signedIn()
        && (resource.data.parentUid == request.auth.uid
            || resource.data.studentUid == request.auth.uid);
    }
  }
}
